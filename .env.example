# Connection string for the main database
DATABASE_URL=postgresql://postgres@localhost:5432/congress

# Optional: separate database used only by the automated tests
TEST_DATABASE_URL=postgresql://postgres@localhost:5432/congress_test

# Folder where downloaded source files are kept unchanged
RAW_DATA_DIR=data/raw

# Free key from https://api.data.gov/signup (used in a later phase)
CONGRESS_API_KEY=
