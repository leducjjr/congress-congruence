# Connection string for the main database
DATABASE_URL=postgresql://postgres@localhost:5432/congress

# Optional: separate database used only by the automated tests
TEST_DATABASE_URL=postgresql://postgres@localhost:5432/congress_test

# Folder where downloaded source files are kept unchanged
RAW_DATA_DIR=data/raw

# Free key from https://api.data.gov/signup: Congress.gov API, for bill subjects used by search
CONGRESS_API_KEY=

# Free key from https://api.census.gov/data/key_signup.html (population per state and district)
CENSUS_API_KEY=

# Optional: where the survey watcher sends "a new survey needs review" messages.
# An ntfy.sh topic works well (install the ntfy app and subscribe to the same topic):
# NOTIFY_URL=https://ntfy.sh/pick-a-long-random-topic-name

# Optional: healthchecks.io ping URLs per scheduled job (see deploy/README.md)
# HEALTHCHECK_BACKUP=
# HEALTHCHECK_MEMBERS=
# HEALTHCHECK_HOUSE=
# HEALTHCHECK_SENATE_VOTEVIEW=
# HEALTHCHECK_SURVEY_WATCH=
# HEALTHCHECK_BILLS=

# Feedback form (Contact page): messages are emailed from this send-only mailbox to FEEDBACK_TO and
# never stored. Without these three lines the form says to use email instead.
# FEEDBACK_SMTP_USER=feedback@uscongressvsvoters.org
# FEEDBACK_SMTP_PASSWORD=
# FEEDBACK_TO=contact@uscongressvsvoters.org
# Visitors who give an address get a copy of their message, with replies going to FEEDBACK_TO.
# Its From address is the sending mailbox unless this is set (see deploy/README.md first):
# FEEDBACK_COPY_FROM=contact@uscongressvsvoters.org
# FEEDBACK_SMTP_HOST=smtp.titan.email      (default)
# FEEDBACK_SMTP_PORT=465                   (default; 587 uses STARTTLS)

# Reminder emails (config/reminders.yaml), sent daily through the FEEDBACK_SMTP mailbox. Where they
# go; kept here, not in the code, so it can be a private address. Defaults to FEEDBACK_TO.
# REMINDERS_TO=
